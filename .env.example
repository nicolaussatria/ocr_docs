# Copy to .env and fill in:  cp .env.example .env
# .env holds the API key - keep it on the server only (chmod 600 .env).

# Optional. Empty: anyone who can reach the server can scan, no key asked.
# Set: everyone enters it once in the review page under "Connection settings".
# Make one with:  openssl rand -hex 32
DOCSCAN_API_KEY=

# Workers = CPU cores for DocScan / 2.  16 cores -> 8 workers, 8 cores -> 4, 4 cores -> 2.
# RAM: about 1.5 GB per worker while scanning, plus 2 GB for the system.
DOCSCAN_WORKERS=8

# CPU cores one worker uses for one scan. Keep 2.
DOCSCAN_THREADS=2

# Port people open in the browser (http://<server-ip>:<port>/). 80 needs no port in the address.
DOCSCAN_PORT=80

# Any other setting from README "Configuration (env DOCSCAN_*)" can be added here, for example:
# DOCSCAN_REVIEW_THRESHOLD=0.85
# DOCSCAN_MAX_UPLOAD_MB=20
